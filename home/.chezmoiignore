# Managed by chezmoi. Do not edit directly. Update via chezmoi, using OS/host-specific partitioning when needed.
.DS_Store
.config/nvim/lazy-lock.json

{{- $isDarwin := eq .chezmoi.os "darwin" }}
{{- $isLinux := eq .chezmoi.os "linux" }}
{{- $profile := includeTemplate "profile" . | trim }}

{{ if not $isDarwin -}}
.Brewfile
.config/karabiner/**
{{ end -}}

{{ if or $isDarwin (eq $profile "server") -}}
.config/autostart/**
.config/systemd/user/rgb-load.service
.config/systemd/user/rgb-load.timer
.local/bin/rgb_load_once.sh
.xinputrc
.xprofile
{{ end -}}

{{ if ne $profile "server" -}}
.local/bin/mpv-vt
{{ end -}}

{{ if eq $profile "raspberrypi" -}}
.config/autostart/**
.config/systemd/user/rgb-load.service
.config/systemd/user/rgb-load.timer
.local/bin/rgb_load_once.sh
{{ end -}}

{{ if ne $profile "desktop" -}}
# KDE Plasma settings (see KDE.md) only apply to Linux desktop machines.
.config/kdeglobals
.config/kglobalshortcutsrc
.config/krunnerrc
.config/kwinrc
.config/plasmashellrc
.config/environment.d
.config/environment.d/**
{{ end -}}

# Plasma 5 applet/layout state is tied to the old desktop version and screen geometry.
.config/plasma-org.kde.plasma.desktop-appletsrc
