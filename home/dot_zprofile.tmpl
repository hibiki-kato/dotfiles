# Managed by chezmoi. Do not edit directly. Update via chezmoi, using OS/host-specific partitioning when needed.
{{- $isDarwin := eq .chezmoi.os "darwin" }}
{{- $isLinux := eq .chezmoi.os "linux" }}
{{- $profile := includeTemplate "profile" . | trim }}

{{ if $isDarwin -}}
# macOS: Homebrew shellenv
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else if $isLinux -}}
# Linuxbrew shellenv
if [ -x "/home/linuxbrew/.linuxbrew/bin/brew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi

{{ if eq $profile "server" -}}
# TTY Japanese input
if [ "$TERM" = "linux" ] && [ -z "${DISPLAY:-}" ] && [ -z "${UIM_FEP_STARTED:-}" ] && command -v uim-fep >/dev/null 2>&1; then
    if [ "$COLORTERM" = "kmscon" ] || [ "$TERM_SESSION_TYPE" = "kms" ]; then
        export TERM=xterm-256color
    fi
    export UIM_FEP_STARTED=1
    exec uim-fep -t 0.1 -u mozc
fi

{{ end -}}
{{ if eq $profile "desktop" -}}
# Load /etc/profile.d settings (resolves missing Flatpak/Snap app icons in Plasma under zsh)
emulate sh -c 'source /etc/profile'

# Ensure Snap desktop applications are recognized by Linux Desktop Environments (Plasma, GNOME, etc.)
if [ -d "/var/lib/snapd/desktop" ]; then
    export XDG_DATA_DIRS="/var/lib/snapd/desktop:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
fi
{{ end -}}
{{ end -}}
