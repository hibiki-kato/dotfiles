{{- /* Machine profile: macos | desktop | server | raspberrypi.
       Override with CHEZMOI_INSTALL_PROFILE (raspi is accepted as raspberrypi).
       Usage: {{- $profile := includeTemplate "profile" . | trim }} */ -}}
{{- $override := env "CHEZMOI_INSTALL_PROFILE" -}}
{{- if eq $override "raspi" -}}
raspberrypi
{{- else if has $override (list "macos" "desktop" "server" "raspberrypi") -}}
{{ $override }}
{{- else if $override -}}
{{ fail (printf "Unsupported CHEZMOI_INSTALL_PROFILE: %s" $override) }}
{{- else if eq .chezmoi.os "darwin" -}}
macos
{{- else if eq .chezmoi.os "linux" -}}
  {{- $osID := .chezmoi.osRelease.id -}}
  {{- $osName := "" -}}
  {{- $osPrettyName := "" -}}
  {{- if hasKey .chezmoi.osRelease "name" -}}
    {{- $osName = .chezmoi.osRelease.name -}}
  {{- end -}}
  {{- if hasKey .chezmoi.osRelease "prettyName" -}}
    {{- $osPrettyName = .chezmoi.osRelease.prettyName -}}
  {{- end -}}
  {{- if or (eq $osID "raspbian") (contains "raspberry" (lower $osName)) (contains "raspberry" (lower $osPrettyName)) -}}
raspberrypi
  {{- else -}}
{{ output "sh" "-c" "if command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W -f='${Status}\\n' ubuntu-desktop ubuntu-desktop-minimal xubuntu-desktop kubuntu-desktop lubuntu-desktop ubuntu-mate-desktop 2>/dev/null | grep -q 'install ok installed'; then printf desktop; elif command -v systemctl >/dev/null 2>&1 && [ \"$(systemctl get-default 2>/dev/null)\" = graphical.target ] && systemctl list-unit-files display-manager.service 2>/dev/null | grep -q display-manager.service; then printf desktop; else printf server; fi" }}
  {{- end -}}
{{- else -}}
unknown
{{- end -}}
